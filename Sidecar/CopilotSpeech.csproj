<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CopilotSpeech</AssemblyName>
    <RootNamespace>CopilotSpeech</RootNamespace>
    <AssemblyTitle>CopilotSpeech</AssemblyTitle>
    <Description>Voice Engine for CrewMate</Description>
    <Product>CrewMate</Product>
    <Company>CrewMate</Company>
    <!-- CI passes -p:Version from the v* tag; local builds report 0.0.0-dev -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>
</Project>
